{
  "theme": {
    "enableHypr": true,
    "enableDiscord": true,
    "enableSpicetify": true
  },
  "toggles": {
    "communication": {
      "discord": {
        "enable": true,
        "match": [{ "class": "discord" }],
        "command": ["discord"],
        "move": true
      }
    },
    "music": {
      "spotify": {
        "enable": true,
        "match": [{ "class": "Spotify" }, { "initialTitle": "Spotify" }, { "initialTitle": "Spotify Free" }],
        "command": ["spicetify", "watch", "-s"],
        "move": true
      }
    }
  }
}
